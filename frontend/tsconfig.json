{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    // Los imports y variables sin usar los reporta ESLint, que ya está
    // configurado en el proyecto. Aquí bloqueaban `tsc` y con él el build de
    // producción: 61 de los 72 errores que impedían desplegar eran esto, y
    // ninguno es un fallo de tipos. La comprobación de tipos de verdad
    // (`strict`) sigue activa y sí frena el despliegue si algo está mal.
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    }
  },
  "include": ["src"],
  "references": [{ "path": "./tsconfig.node.json" }]
}